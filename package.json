{
  "name": "spatial-scenes",
  "version": "0.5.1",
  "description": "Turn a single photo into an interactive 3D parallax scene",
  "author": "Dave Matteer",
  "license": "MIT",
  "packageManager": "bun@1.2.4",
  "workspaces": [
    "./server",
    "./client",
    "./shared"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=client",
    "dev:server": "turbo dev --filter=server",
    "build": "turbo build",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "postinstall": "turbo build --filter=shared"
  },
  "keywords": [
    "three.js",
    "react",
    "depth-estimation",
    "parallax",
    "vite"
  ],
  "devDependencies": {
    "bun-types": "latest",
    "tailwind-scrollbar": "^4.0.2",
    "turbo": "^2.6.3"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  }
}
